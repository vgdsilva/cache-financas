@using VGS.FinanceIA.ViewComponents
@model AppNavModel

@* Mobile: topbar com hambúrguer; o menu desce abaixo dela. Desktop: a topbar some e a sidebar fica fixa. *@
<header class="topbar">
  <a class="brand" href="/">
    <span class="brand-mark" aria-hidden="true">F</span>
    <span class="brand-name">FinanceIA</span>
  </a>
  <button type="button" class="nav-toggler" data-nav-toggle aria-controls="app-menu" aria-expanded="false" aria-label="Abrir menu">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path class="icon-bars" d="M4 6h16M4 12h16M4 18h16" />
      <path class="icon-close" d="M6 6l12 12M18 6L6 18" />
    </svg>
  </button>
</header>

<div class="nav-backdrop" data-nav-backdrop></div>

<aside class="sidebar" id="app-menu">
  <div class="sidebar-head">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">F</span>
      <span class="brand-name">FinanceIA</span>
    </a>
    <button type="button" class="collapse-btn" data-nav-collapse aria-expanded="true" aria-label="Recolher menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 6l-6 6 6 6" />
      </svg>
    </button>
  </div>

  <nav class="nav" aria-label="Navegação principal">
    @foreach (var group in Model.Sections)
    {
      <div class="nav-section">
        @if (group.Title is not null)
        {
          <p class="nav-section-title">@group.Title</p>
        }
        <ul class="nav-list">
          @foreach (var item in group.Items)
          {
            var current = Context.Request.Path.StartsWithSegments(item.Url);
            <li>
              <a class="nav-link" href="@item.Url" title="@item.Description" aria-current="@(current ? "page" : null)">
                @NavIcons.Render(item.Icon)
                <span class="nav-label">@item.Description</span>
              </a>
            </li>
          }
        </ul>
      </div>
    }
  </nav>

  <div class="sidebar-foot">
    <div class="user">
      <span class="avatar" aria-hidden="true">@Model.Initial</span>
      <span class="user-name nav-label">@Model.UserName</span>
    </div>
    <form method="post" asp-page="/Logout">
      <button type="submit" class="nav-link nav-button" title="Sair">
        @NavIcons.Render("logout")
        <span class="nav-label">Sair</span>
      </button>
    </form>
  </div>
</aside>

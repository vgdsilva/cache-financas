@page
@model LoginModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Entrar";
}

<div class="auth">
  <section class="auth-main">
    <div class="auth-card">
      <div class="brand brand--lg">
        <span class="brand-mark" aria-hidden="true">C</span>
        <span class="brand-name">CacheFinancas</span>
      </div>

      <h1 class="auth-title">Bem-vindo de volta</h1>
      <p class="auth-lead">Entre para acompanhar suas finanças.</p>

      <form method="post" class="form" data-login-form>
        <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>
        <input type="hidden" asp-for="ReturnUrl" />

        <div class="field">
          <label asp-for="UserName">Usuário</label>
          <input asp-for="UserName" autocomplete="username" autocapitalize="none" spellcheck="false" autofocus />
          <span asp-validation-for="UserName" class="field-error"></span>
        </div>

        <div class="field">
          <label asp-for="Password">Senha</label>
          <div class="input-group">
            <input asp-for="Password" type="password" autocomplete="current-password" />
            <button type="button" class="input-toggle" data-password-toggle aria-label="Mostrar senha" hidden>Mostrar</button>
          </div>
          <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <button type="submit" class="btn btn-primary" data-submit>
          <span class="btn-label">Entrar</span>
          <span class="spinner" aria-hidden="true"></span>
        </button>
      </form>
    </div>
  </section>

  <aside class="auth-aside" aria-hidden="true">
    <div class="auth-aside-inner">
      <div class="brand brand--on-dark">
        <span class="brand-mark" aria-hidden="true">C</span>
        <span class="brand-name">CacheFinancas</span>
      </div>
      <p class="auth-tagline">Controle financeiro pessoal, com um assistente de IA.</p>
    </div>
  </aside>
</div>

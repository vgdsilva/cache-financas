@page "/configuracoes/usuarios/password/{id:guid}"
@model SenhaModel
@{
    ViewData["Title"] = "Redefinir senha";
}

<div class="page-header">
  <div class="page-crumb">Configurações · Usuários</div>
  <h1>Redefinir senha</h1>
</div>

<form method="post" class="card form form--narrow">
  <p class="card-text">Nova senha para <strong>@Model.UserName</strong>. As sessões que ele já tiver abertas continuam valendo até expirar.</p>

  <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>

  <div class="field">
    <label asp-for="Input.NewPassword">Nova senha</label>
    <input asp-for="Input.NewPassword" type="password" autocomplete="new-password" autofocus />
    <span asp-validation-for="Input.NewPassword" class="field-error"></span>
  </div>

  <div class="field">
    <label asp-for="Input.ConfirmNewPassword">Confirmar nova senha</label>
    <input asp-for="Input.ConfirmNewPassword" type="password" autocomplete="new-password" />
    <span asp-validation-for="Input.ConfirmNewPassword" class="field-error"></span>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Redefinir senha</button>
    <a class="btn btn-secondary" asp-page="Index">Cancelar</a>
  </div>
</form>

@* Campos compartilhados por Criar e Editar. Model = a própria página (UsuarioFormPageModel). *@
@model UsuarioFormPageModel

<div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>

<div class="field">
  <label asp-for="Input.UserName">Usuário</label>
  <input asp-for="Input.UserName" autocomplete="off" autocapitalize="none" spellcheck="false" autofocus />
  <span asp-validation-for="Input.UserName" class="field-error"></span>
</div>

@if (!Model.IsEdit)
{
  <div class="field">
    <label asp-for="Input.Password">Senha</label>
    <input asp-for="Input.Password" type="password" autocomplete="new-password" />
    <span asp-validation-for="Input.Password" class="field-error"></span>
  </div>

  <div class="field">
    <label asp-for="Input.ConfirmPassword">Confirmar senha</label>
    <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" />
    <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
  </div>
}

<label class="check">
  <input type="checkbox" asp-for="Input.IsAdmin" data-admin-toggle />
  <span>
    Administrador
    <small>Acessa todos os menus e gerencia usuários.</small>
  </span>
</label>

<fieldset class="menus" data-menus disabled="@Model.Input.IsAdmin">
  <legend>Menus liberados</legend>
  <p class="menus-hint">Quais telas este usuário pode abrir. Administrador acessa todas, então a escolha não se aplica.</p>

  @foreach (var group in Model.AvailableMenus.GroupBy(m => m.Group))
  {
    <div class="menus-group">
      <p class="menus-group-title">@group.Key</p>
      <div class="menus-options">
        @foreach (var menu in group)
        {
          <label class="check">
            <input type="checkbox" name="Input.MenuCodes" value="@menu.Code" checked="@Model.Input.MenuCodes.Contains(menu.Code)" />
            <span>@menu.Description</span>
          </label>
        }
      </div>
    </div>
  }
</fieldset>

<div class="form-actions">
  <button type="submit" class="btn btn-primary">Salvar</button>
  <a class="btn btn-secondary" asp-page="Index">Cancelar</a>
</div>

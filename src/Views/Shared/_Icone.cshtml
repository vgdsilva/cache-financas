@* Ícones do padrão de CRUD: Font Awesome, como no CRM (fonte em wwwroot/fonts, glifos em site.css). Model = nome do ícone.
   Tamanho vem do CSS (.ico); a cor é a do texto ao redor. Ícone novo = glifo `.fa-xxx::before` em site.css + um case aqui. *@
@model string

@{
    var glyph = Model switch
    {
        "adicionar" => "fa-plus",
        "editar" => "fa-edit",
        "remover" => "fa-times",
        "excluir" => "fa-trash",
        "salvar" => "fa-save",
        "desfazer" => "fa-undo",
        "senha" => "fa-key",
        "atualizar" => "fa-sync",
        "redirecionar" => "fa-arrow-right",
        "pesquisar" => "fa-search",
        "igual" => "fa-equals",
        "lista" => "fa-bars",
        _ => throw new InvalidOperationException($"Ícone '{Model}' não existe em _Icone.cshtml.")
    };
}
<i class="ico @glyph" aria-hidden="true"></i>

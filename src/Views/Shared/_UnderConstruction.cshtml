@* Página base de um menu: cabeçalho (título vindo do catálogo) + aviso. Model = código do menu. *@
@model string
@{
    var menu = Menus.Find(Model) ?? throw new InvalidOperationException($"Menu '{Model}' não existe no catálogo.");
    var parentTitle = menu.ParentCode is null ? null : Menus.Find(menu.ParentCode)?.Description;
}

<header class="page-head">
  <h1 class="page-title">@menu.Description</h1>
</header>

<section class="section">
  <div class="section-head">
    <h2 class="section-title">@(parentTitle is null ? menu.Description : $"{parentTitle} · {menu.Description}")</h2>
  </div>

  <div class="section-body">
    <p class="section-text">Em construção</p>
    <p class="section-text section-text--muted">Esta tela ainda será construída. A rota <code>@menu.Url</code> e a permissão do menu já estão valendo.</p>
  </div>
</section>

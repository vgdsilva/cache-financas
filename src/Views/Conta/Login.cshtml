@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Entrar";

    // Campo com erro de validação: rótulo e borda ficam vermelhos (padrão do login do CRM).
    string ErrorClass(string key) => ViewData.ModelState[key]?.Errors.Count > 0 ? " has-error" : "";
}

<div class="auth">
  @* Lado esquerdo: no CRM é o carrossel de imagens; aqui é só a marca. Some abaixo de 1024px. *@
  <section class="auth-image" aria-hidden="true">
    <div class="auth-image-inner">
      <span class="brand-mark" aria-hidden="true">C</span>
      <p class="auth-image-name">CacheFinancas</p>
      <p class="auth-image-tagline">Controle financeiro pessoal, com um assistente de IA.</p>
    </div>
  </section>

  <section class="auth-form">
    <div class="auth-center">
      <div class="auth-logo">
        <div class="brand">
          <span class="brand-mark" aria-hidden="true">C</span>
          <span class="brand-name">CacheFinancas</span>
        </div>
      </div>

      <form method="post" class="auth-wrapper" data-login-form>
        <h1 class="auth-title">Seja bem-vindo(a)</h1>

        <div asp-validation-summary="ModelOnly" class="mensagem-feedback mensagem-feedback-error" role="alert"></div>
        <input type="hidden" asp-for="ReturnUrl" />

        <div class="auth-fields">
          <div class="auth-field@(ErrorClass("UserName"))">
            <label asp-for="UserName">Usuário<span>*</span></label>
            <div class="auth-input">
              <input asp-for="UserName" placeholder="Informe o usuário" autocomplete="username" autocapitalize="none" spellcheck="false" autofocus />
            </div>
            <span asp-validation-for="UserName" class="validation"></span>
          </div>

          <div class="auth-field@(ErrorClass("Password"))">
            <label asp-for="Password">Senha<span>*</span></label>
            <div class="auth-input has-toggle">
              <input asp-for="Password" type="password" placeholder="Informe sua senha" autocomplete="current-password" />
              <button type="button" class="reveal-password" data-password-toggle aria-label="Mostrar senha" hidden><i class="ico fa-eye-slash" aria-hidden="true"></i></button>
            </div>
            <span asp-validation-for="Password" class="validation"></span>
          </div>
        </div>

        <button type="submit" class="btn-web" data-submit>Entrar</button>
      </form>
    </div>

    <footer class="auth-footer">
      <div>&copy; @DateTime.Now.Year CacheFinancas</div>
    </footer>
  </section>

  <div class="auth-loading" data-loading hidden aria-hidden="true"><i class="ico fa-circle-notch fa-spin" aria-hidden="true"></i></div>
</div>

@model ExcluirViewModel
@{
    ViewData["Title"] = "Excluir usuário";
}

@* Ação destrutiva: o botão vermelho fica dentro da confirmação, nunca na barra do topo. *@
<header class="page-head">
  <h1 class="page-title">Excluir usuário</h1>
</header>

<form method="post" class="crud-form">
  <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>

  <div class="widget">
    <section class="section">
      <div class="section-head">
        <h2 class="section-title">Confirmação</h2>
      </div>

      <div class="section-body">
        <p class="section-text">Excluir <strong>@Model.UserName</strong>?</p>
        <p class="section-text section-text--muted">O usuário perde o acesso na hora, junto com os menus e as configurações dele. O cadastro fica guardado, e um novo usuário pode reutilizar este nome.</p>

        @if (Model.IsSelf)
        {
          <div class="alert alert-error" role="alert">Você não pode excluir o seu próprio usuário.</div>
        }

        <div class="form-footer">
          <a class="btn btn-secondary" asp-action="Index"><partial name="_Icone" model='"desfazer"' />Cancelar</a>
          @if (!Model.IsSelf)
          {
            <button type="submit" class="btn btn-danger"><partial name="_Icone" model='"remover"' />Excluir</button>
          }
        </div>
      </div>
    </section>
  </div>
</form>

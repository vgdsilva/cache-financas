@model UsuarioFormViewModel
@{
    ViewData["Title"] = "Editar usuário";
}

<header class="page-head">
  <h1 class="page-title">Editar usuário</h1>
  <div class="page-actions">
    <a class="btn btn-secondary" asp-action="Index"><partial name="_Icone" model='"desfazer"' />Cancelar</a>
    <button type="submit" class="btn btn-primary" form="form-usuario"><partial name="_Icone" model='"salvar"' />Salvar</button>
  </div>
</header>

<form id="form-usuario" method="post" class="crud-form">
  <partial name="_Formulario" model="Model" />
</form>

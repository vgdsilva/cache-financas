@using CacheFinancas.Domain.Enums
@model CacheFinancas.Models.CriarUsuarioViewModel
@{
    ViewData["Title"] = "Novo usuário";
}

<div class="row">
    <div class="col-md-6 col-lg-5">
        <h1 class="h3 mb-3">Novo usuário</h1>
        <form asp-action="Criar" method="post" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label asp-for="Nome" class="form-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SenhaTemporaria" class="form-label"></label>
                <input asp-for="SenhaTemporaria" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="SenhaTemporaria" class="text-danger"></span>
                <div class="form-text">Mínimo de 10 caracteres. O usuário deverá trocá-la no primeiro acesso.</div>
            </div>
            <div class="mb-3">
                <label asp-for="Perfil" class="form-label"></label>
                <select asp-for="Perfil" class="form-select">
                    <option value="@PerfilUsuario.Usuario">Usuário</option>
                    <option value="@PerfilUsuario.Admin">Admin</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Criar</button>
            <a class="btn btn-link" href="/Admin/Usuarios">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@using CacheFinancas.Domain.Enums
@model CacheFinancas.Models.UsuariosIndexViewModel
@{
    ViewData["Title"] = "Usuários";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Usuários</h1>
    <a class="btn btn-primary" href="/Admin/Usuarios/Criar">Novo usuário</a>
</div>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr><th>Nome</th><th>E-mail</th><th>Perfil</th><th>Situação</th><th class="text-end">Ações</th></tr>
        </thead>
        <tbody>
        @foreach (var u in Model.Usuarios)
        {
            <tr>
                <td>@u.Nome</td>
                <td>@u.Email</td>
                <td>@(u.Perfil == PerfilUsuario.Admin ? "Admin" : "Usuário")</td>
                <td>
                    @if (!u.Ativo) { <span class="badge text-bg-secondary">Inativo</span> }
                    else if (u.Bloqueado) { <span class="badge text-bg-danger">Bloqueado</span> }
                    else { <span class="badge text-bg-success">Ativo</span> }
                    @if (u.DeveTrocarSenha) { <span class="badge text-bg-warning">Trocar senha</span> }
                </td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" href="/Admin/Usuarios/@u.Id/RedefinirSenha">Redefinir senha</a>
                    @if (u.Bloqueado)
                    {
                        <form method="post" action="/Admin/Usuarios/@u.Id/Desbloquear" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-outline-warning">Desbloquear</button>
                        </form>
                    }
                    @if (u.Id != Model.UsuarioLogadoId)
                    {
                        <form method="post" action="/Admin/Usuarios/@u.Id/Ativo" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ativo" value="@(u.Ativo ? "false" : "true")" />
                            <button class="btn btn-sm @(u.Ativo ? "btn-outline-danger" : "btn-outline-success")">@(u.Ativo ? "Desativar" : "Ativar")</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

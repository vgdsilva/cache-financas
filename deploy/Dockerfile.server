# syntax=docker/dockerfile:1
# Contexto de build: raiz do repositorio (ver deploy/docker-compose.yml)

ARG DOTNET_TAG=11.0

FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_TAG} AS build
WORKDIR /src

# Restore em camada separada: so invalida quando o .csproj muda
COPY src/api/SistemaFinanceiro.Web.Api/SistemaFinanceiro.Web.Api.csproj api/SistemaFinanceiro.Web.Api/
RUN dotnet restore api/SistemaFinanceiro.Web.Api/SistemaFinanceiro.Web.Api.csproj

COPY src/api/SistemaFinanceiro.Web.Api/ api/SistemaFinanceiro.Web.Api/
RUN dotnet publish api/SistemaFinanceiro.Web.Api/SistemaFinanceiro.Web.Api.csproj \
    -c Release -o /app/publish --no-restore /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_TAG}-alpine AS final
WORKDIR /app

ENV ASPNETCORE_URLS=http://+:3333 \
    DOTNET_EnableDiagnostics=0

COPY --from=build --chown=$APP_UID /app/publish .
USER $APP_UID

EXPOSE 3333
ENTRYPOINT ["dotnet", "SistemaFinanceiro.Web.Api.dll"]

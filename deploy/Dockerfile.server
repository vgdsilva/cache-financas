# syntax=docker/dockerfile:1
# Contexto de build: raiz do repositorio (ver deploy/docker-compose.yml)

ARG DOTNET_TAG=11.0

FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_TAG} AS build
WORKDIR /src

# Restore em camada separada: so invalida quando o .csproj muda
COPY src/FMS.Domain/FMS.Domain.csproj FMS.Domain/
COPY src/FMS.Web.Api.Data/FMS.Web.Api.Data.csproj FMS.Web.Api.Data/
COPY src/FMS.Web.Api/FMS.Web.Api.csproj FMS.Web.Api/
RUN dotnet restore FMS.Web.Api/FMS.Web.Api.csproj

COPY src/FMS.Domain/ FMS.Domain/
COPY src/FMS.Web.Api.Data/ FMS.Web.Api.Data/
COPY src/FMS.Web.Api/ FMS.Web.Api/
RUN dotnet publish FMS.Web.Api/FMS.Web.Api.csproj \
    -c Release -o /app/publish --no-restore /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_TAG}-alpine AS final
WORKDIR /app

ENV ASPNETCORE_URLS=http://+:3333 \
    DOTNET_EnableDiagnostics=0

COPY --from=build --chown=$APP_UID /app/publish .
USER $APP_UID

EXPOSE 3333
ENTRYPOINT ["dotnet", "FMS.Web.Api.dll"]

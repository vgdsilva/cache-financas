RUN dotnet publish api/FMS.Web.Api/FMS.Web.Api.csproj \
    -c Release -o /app/publish --no-restore /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_TAG}-alpine AS final
WORKDIR /app

ENV ASPNETCORE_URLS=http://+:3333 \
    DOTNET_EnableDiagnostics=0

COPY --from=build --chown=$APP_UID /app/publish .
USER $APP_UID

EXPOSE 3333
ENTRYPOINT ["dotnet", "FMS.Web.Api.dll"]

# syntax=docker/dockerfile:1
# Contexto de build: raiz do repositorio (ver deploy/docker-compose.yml)
# Blazor WebAssembly publicado como estaticos e servido pelo nginx.

ARG DOTNET_TAG=11.0

FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_TAG} AS build
WORKDIR /src

# Restore em camada separada: so invalida quando o .csproj muda
COPY src/FMS.Web/FMS.Web.csproj web/FMS.Web/
RUN dotnet restore web/FMS.Web/FMS.Web.csproj

COPY src/FMS.Web/ web/FMS.Web/
RUN dotnet publish web/FMS.Web/FMS.Web.csproj \
    -c Release -o /app/publish --no-restore

FROM nginx:1.27-alpine AS final
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/publish/wwwroot /usr/share/nginx/html

EXPOSE 8080

# Copie para deploy/.env apenas para testes locais. Em producao o arquivo
# e gerado pelo workflow a partir dos GitHub Secrets. Nunca commite o .env.
# Evite espacos, aspas e # na senha.

ASPNETCORE_ENVIRONMENT=Production

POSTGRES_DB=cachefinancas
POSTGRES_USER=cachefinancas
POSTGRES_PASSWORD=TROQUE_ME

# Chave de assinatura do JWT (minimo 32 caracteres). Gere com: openssl rand -base64 48
JWT_SECRET=TROQUE_ME

# Senha do admin inicial (login "admin"). Usada so se o usuario ainda nao existir.
SEED_ADMIN_PASSWORD=TROQUE_ME

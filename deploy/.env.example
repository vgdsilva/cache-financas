# Copie para deploy/.env apenas para testes locais. Em producao o arquivo
# e gerado pelo workflow a partir dos GitHub Secrets. Nunca commite o .env.

ASPNETCORE_ENVIRONMENT=Production

# Host "postgres" = nome do container na rede externa db-net
ConnectionStrings__Default=Host=postgres;Port=5432;Database=cachefinancas;Username=cachefinancas;Password=TROQUE_ME

# Aplica migrations no startup (so ligar no deploy)
Database__MigrarNoStartup=true

# Admin inicial: usado apenas se nao houver nenhum usuario. Troca de senha obrigatoria no 1o login.
Bootstrap__AdminEmail=admin@exemplo.com
Bootstrap__AdminSenha=TROQUE_ME_COM_10_OU_MAIS
